{
  "name": "slow-dough-pizza",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:cms": "node tools/dev-with-cms.mjs",
    "dev:cms:git": "node tools/dev-with-cms.mjs --git",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "validate:content": "node tools/validate-content.mjs",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.mjs\"",
    "check": "npm run validate:content && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "decap-cms": "3.8.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "decap-server": "3.3.0",
    "js-yaml": "4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.6"
  }
