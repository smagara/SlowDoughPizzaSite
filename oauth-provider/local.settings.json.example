{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "OAUTH_GITHUB_CLIENT_ID": "replace-with-your-github-oauth-app-client-id",
    "OAUTH_GITHUB_CLIENT_SECRET": "replace-with-your-github-oauth-app-client-secret",
    "OAUTH_GITHUB_SCOPE": "repo,user"
  }
}
